NODE_ENV=development
PORT=3000

# Local Docker Postgres (docker-compose.yml):
#   postgresql://ccwp:ccwp_dev_password@localhost:5432/ccwp
#
# Postgres connection string. Use a session pooler (port 5432), not a
# transaction pooler: migrations run DDL and TypeORM/better-auth use prepared
# statements. SSL is applied automatically for any non-localhost host.
#   postgresql://<user>:<password>@<host>:5432/<database>
DATABASE_URL=postgresql://ccwp:ccwp_dev_password@localhost:5432/ccwp

BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

FRONTEND_URL=http://localhost:5173
